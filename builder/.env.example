# ============================================================
# Apnosh Builder System — Environment Variables
# Copy to .env and fill in real values
# ============================================================

# --- Discord ---
# Create a bot at https://discord.com/developers/applications
# Bot needs: applications.commands, bot scopes
# Bot permissions: Send Messages, Embed Links, Use Slash Commands
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Channel where the bot posts status updates and heartbeat alerts
DISCORD_CHANNEL_ID=

# User ID for @mark mentions on items needing human review
DISCORD_ADMIN_USER_ID=

# --- Supabase ---
# Project URL and service role key (NOT anon key — this runs server-side)
# Find at: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- GitHub ---
# Personal access token with repo read access
# Create at: https://github.com/settings/tokens
# Scopes needed: repo (read)
GITHUB_TOKEN=
GITHUB_OWNER=Apnosh
GITHUB_REPO=apnosh-portal

# --- Anthropic (Claude API) ---
# For Layer 2 KB synthesis
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Runtime ---
# Timezone for cron schedules (Layer 2 runs at 2am in this timezone)
TZ=America/Los_Angeles
